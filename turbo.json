{
	"$schema": "https://turborepo.com/schema.json",
	"globalEnv": [
		"DATABASE_URL",
		"REDIS_URL",
		"NODE_ENV",
		"PORT",
		"LOG_LEVEL",
		"JWT_SECRET",
		"GOOGLE_CLIENT_ID",
		"APP_URL",
		"MAIL_FROM",
		"ENCRYPTION_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/**",
				"tsconfig*.json"
			],
			"outputs": [
				"dist/**"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"test": {
			"dependsOn": [
				"^build"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
