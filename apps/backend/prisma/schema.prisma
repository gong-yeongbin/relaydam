generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── enum ────────────────────────────────────────────────────────────────
// 값은 소문자. API가 Prisma 행을 그대로 반환하므로 응답에도 그대로 나간다.

enum Plan {
  free
  team
  business
}

// subscription에는 free가 없다. free 조직은 subscription 행이 없다.
enum SubscriptionPlan {
  team
  business
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum IdentityProvider {
  google
}

enum MemberRole {
  owner
  admin
  member
}

// 초대로 줄 수 있는 역할. owner는 조직당 1명이라 초대로 주지 않는다.
enum InvitationRole {
  admin
  member
}

enum PaymentStatus {
  pending
  paid
  failed
}

// ─── 계정·테넌트 ─────────────────────────────────────────────────────────

model organization {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  // 인그레스·가드가 보는 현재 적용 플랜. subscription을 조인하지 않으려고 둔다.
  plan       Plan     @default(free)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  members       organization_member[]
  invitations   invitation[]
  projects      project[]
  subscription  subscription?
  usage_periods usage_period[]
}

model user {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  name       String   @db.VarChar(100)
  avatar_url String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  identities  user_identity[]
  memberships organization_member[]
  invitations invitation[]
}

model user_identity {
  id               Int              @id @default(autoincrement())
  user             user             @relation(fields: [user_id], references: [id])
  user_id          Int
  provider         IdentityProvider
  provider_user_id String           @db.VarChar(255)
  created_at       DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

// 조직당 owner 1명은 마이그레이션 SQL의 부분 유니크 인덱스로 강제한다.
// CREATE UNIQUE INDEX organization_member_one_owner ON organization_member (organization_id) WHERE role = 'owner';
model organization_member {
  organization    organization @relation(fields: [organization_id], references: [id])
  organization_id Int
  user            user         @relation(fields: [user_id], references: [id])
  user_id         Int
  role            MemberRole
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([organization_id, user_id])
  @@index([user_id])
}

// 조직 아래 작업 단위. 소스·목적지·이벤트·api_key가 여기에 속한다.
// 같은 조직 안에서 이름은 대소문자를 무시하고 유일하다. 마이그레이션 SQL의 식 인덱스로 강제한다.
// CREATE UNIQUE INDEX project_organization_id_lower_name_key ON project (organization_id, lower(name));
// suspended_at은 결제 실패로 plan이 내려가 project 수가 상한을 넘었을 때 채운다(4. billing). 정지 중에는
// 수신·전달을 멈추고 데이터만 보관한다.
model project {
  id              Int          @id @default(autoincrement())
  organization    organization @relation(fields: [organization_id], references: [id])
  organization_id Int
  name            String       @db.VarChar(100)
  suspended_at    DateTime?    @db.Timestamptz(3)
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  sources      source[]
  destinations destination[]

  @@index([organization_id])
}

// 대기 중인 초대. 수락하면 행을 지운다. 같은 조직·이메일로 다시 초대하면 이 행의 토큰·만료를 바꾼다.
// token_hash는 SHA-256 hex. 원문은 메일에만 있다.
model invitation {
  id                 Int            @id @default(autoincrement())
  organization       organization   @relation(fields: [organization_id], references: [id])
  organization_id    Int
  email              String         @db.VarChar(255)
  role               InvitationRole
  token_hash         String         @unique @db.Char(64)
  expires_at         DateTime       @db.Timestamptz(3)
  invited_by         user           @relation(fields: [invited_by_user_id], references: [id])
  invited_by_user_id Int
  created_at         DateTime       @default(now()) @db.Timestamptz(3)
  updated_at         DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([organization_id, email])
}

// ─── 수신·전달 설정 ──────────────────────────────────────────────────────

// 웹훅을 받는 창구. slug가 인그레스 URL(`/in/:slug`)이고 서버가 만든 소문자+숫자 20자다. 재발급할 수 있다.
// 서명 검증은 선택. signing_secret_enc(AES-256-GCM)와 signature_config는 둘 다 있거나 둘 다 없다.
// 마이그레이션 SQL의 CHECK로 강제한다. config를 비울 때는 JSON null이 아니라 DB NULL(Prisma.DbNull)을 쓴다.
// signature_config는 `{ preset }` 또는 범용 필드. 모양은 zod 스키마가 정한다.
// project를 지우면 같이 지워진다. event가 생기는 7. ingress에서 다시 정한다.
model source {
  id                 Int      @id @default(autoincrement())
  project            project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id         Int
  slug               String   @unique @db.VarChar(20)
  name               String   @db.VarChar(100)
  // select에서 빼고 읽는다.
  signing_secret_enc String?  @db.Text
  signature_config   Json?
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  connections connection[]

  @@index([project_id])
}

// 웹훅을 전달할 고객 서버. headers_enc는 전달 때 덧붙일 헤더 JSON을 AES-256-GCM으로 암호화한 값이고
// 헤더가 없으면 NULL이다. 응답에는 복호화 후 비밀 키의 값을 가려서 낸다. 서킷 상태는 Valkey에 둔다(8. delivery).
model destination {
  id           Int      @id @default(autoincrement())
  project      project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id   Int
  name         String   @db.VarChar(100)
  url          String   @db.VarChar(2048)
  // select에서 빼고 읽는다.
  headers_enc  String?  @db.Text
  timeout_ms   Int      @default(5000)
  max_attempts Int      @default(10)
  concurrency  Int      @default(10)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  connections connection[]

  @@index([project_id])
}

// source → destination M:N. 같은 project끼리만 잇는다(adapter에서 검사). 한 쌍은 한 번만 이을 수 있다.
// 자체 id를 둔 건 다른 리소스와 주소(`/connections/:connectionId`)·커서 페이징을 같게 하려는 것이다.
model connection {
  id             Int         @id @default(autoincrement())
  source         source      @relation(fields: [source_id], references: [id], onDelete: Cascade)
  source_id      Int
  destination    destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)
  destination_id Int
  created_at     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([source_id, destination_id])
  @@index([destination_id])
}

// ─── 결제·사용량 ─────────────────────────────────────────────────────────

// 토스 빌링. free 조직은 행이 없다.
model subscription {
  id                   Int                @id @default(autoincrement())
  organization         organization       @relation(fields: [organization_id], references: [id])
  organization_id      Int                @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  customer_key         String             @unique @db.VarChar(64)
  // AES-256-GCM. select에서 빼고 읽는다.
  billing_key_enc      String             @db.Text
  card_issuer_code     String             @db.VarChar(10)
  card_number_masked   String             @db.VarChar(20)
  current_period_start DateTime           @db.Timestamptz(3)
  current_period_end   DateTime           @db.Timestamptz(3)
  canceled_at          DateTime?          @db.Timestamptz(3)
  created_at           DateTime           @default(now()) @db.Timestamptz(3)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  payments payment[]
}

// Valkey 카운터(org:{id}:usage:{yyyymm})의 스냅샷
model usage_period {
  id              Int          @id @default(autoincrement())
  organization    organization @relation(fields: [organization_id], references: [id])
  organization_id Int
  period_start    DateTime     @db.Date
  event_count     Int          @default(0)
  finalized_at    DateTime?    @db.Timestamptz(3)
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  payments payment[]

  @@unique([organization_id, period_start])
}

// 금액은 원 단위 정수. amount = base_amount + overage_amount
model payment {
  id              Int           @id @default(autoincrement())
  subscription    subscription  @relation(fields: [subscription_id], references: [id])
  subscription_id Int
  // 첫 결제는 기본료만이라 사용량 기간이 없을 수 있다
  usage_period    usage_period? @relation(fields: [usage_period_id], references: [id])
  usage_period_id Int?
  // 서버 생성. 토스 규칙: 영문·숫자·-_ 6~64자
  order_id        String        @unique @db.VarChar(64)
  payment_key     String?       @db.VarChar(200)
  base_amount     Int
  overage_events  Int           @default(0)
  overage_amount  Int           @default(0)
  amount          Int
  status          PaymentStatus @default(pending)
  failure_code    String?       @db.VarChar(100)
  failure_message String?       @db.Text
  paid_at         DateTime?     @db.Timestamptz(3)
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([subscription_id, created_at])
  @@index([usage_period_id])
}
