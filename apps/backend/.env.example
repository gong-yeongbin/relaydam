# API 서버가 바인딩할 포트. 미설정 시 3001.
PORT=3001

# pino 로그 레벨 (trace|debug|info|warn|error|fatal|silent). 미설정 시 info.
LOG_LEVEL=info

# production이면 로그를 JSON 그대로, 그 외에는 pino-pretty로 사람이 읽는 형태로 낸다.
NODE_ENV=development

# PostgreSQL 접속 문자열. 로컬은 docker-compose.yml의 postgres와 맞춘다.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/relaydam

# access JWT 서명 키. 운영은 충분히 긴 무작위 값(예: openssl rand -base64 48).
JWT_SECRET=change-me

# Google Cloud Console에서 발급한 OAuth 웹 클라이언트 ID. ID 토큰의 audience로 검증한다.
GOOGLE_CLIENT_ID=
